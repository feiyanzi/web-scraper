#!/bin/bash
# 网页抓取助手启动器 v1.1
# 支持 42plugin.com、知乎、Twitter 等动态网站

PROJECT_DIR="/Users/feiyanzi22/Desktop/aipd/PACONG APP-2026-3-14/web-scraper-project"
SERVER_URL="http://localhost:5555"
HTML_FILE="$PROJECT_DIR/web-scraper-app.html"

# 检查服务器是否运行
check_server() {
    curl -s "$SERVER_URL/api/config" > /dev/null 2>&1
    return $?
}

# 启动服务器
start_server() {
    cd "$PROJECT_DIR"
    nohup python3 server.py > /tmp/web-scraper.log 2>&1 &
    echo "正在启动服务器..."
    sleep 3
}

# 主逻辑
if ! check_server; then
    start_server
fi

# 打开浏览器
open "$HTML_FILE"
